# Copy to .env (gitignored) and replace every change-me value. Never commit .env.
# Generate a password in PowerShell:
#   [Convert]::ToBase64String([Security.Cryptography.RandomNumberGenerator]::GetBytes(18))
# Postgres users are created only on the first start of an empty volume;
# after changing a password here, run `docker compose down -v` to re-initialise.

# Postgres superuser (admin only, never used by services)
POSTGRES_USER=buzzer_admin
POSTGRES_PASSWORD=change-me

# Per-service database owners (roles <svc>_app, see infra/local/postgres/init/01-databases.sql)
IDENTITY_DB_PASSWORD=change-me
QUIZ_DB_PASSWORD=change-me
SESSION_DB_PASSWORD=change-me
SCORING_DB_PASSWORD=change-me

# Redis requirepass
REDIS_PASSWORD=change-me

# identity-service JWT signing keys, created by `.\tasks.ps1 keys` into .secrets\.
# Absolute Spring resource locations with forward slashes. In a container: file:/run/secrets/jwt-private.pem
IDENTITY_JWT_PRIVATE_KEY_LOCATION=file:D:/dev/buzzer/.secrets/jwt-private.pem
IDENTITY_JWT_PUBLIC_KEY_LOCATION=file:D:/dev/buzzer/.secrets/jwt-public.pem
