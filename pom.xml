<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>dev.nibin.buzzer</groupId>
    <artifactId>buzzer-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>buzzer-parent</name>
    <description>Buzzer real-time multiplayer quiz: parent and aggregator POM</description>

    <properties>
        <java.version>21</java.version>
        <spring-cloud.version>2025.1.2</spring-cloud.version>
    </properties>

    <modules>
        <module>shared-events</module>
        <module>services/identity-service</module>
        <module>services/quiz-service</module>
        <module>services/session-service</module>
        <module>services/scoring-service</module>
        <module>services/gateway</module>
        <module>benchmarks</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>dev.nibin.buzzer</groupId>
                <artifactId>shared-events</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <!-- Tests run in UTC, like the containers in AWS. Also required locally: the JDK on
                     Windows reports "Asia/Calcutta", which postgres:16 (Debian trixie, no tzdata-legacy)
                     rejects at connect time. -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <configuration>
                        <argLine>-Duser.timezone=UTC</argLine>
                        <!-- Actuator on a random port in tests: each service fixes its own (9080-9084) in
                             application.yml, and several test contexts run at once in one JVM. -->
                        <!-- Finished spans are exported in batches every schedule-delay (default seconds): short in
                             tests, so the tracing tests don't wait for them. -->
                        <systemPropertyVariables>
                            <management.server.port>0</management.server.port>
                            <management.opentelemetry.tracing.export.schedule-delay>100ms</management.opentelemetry.tracing.export.schedule-delay>
                        </systemPropertyVariables>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
