# Copy to terraform.tfvars (gitignored) to avoid typing -var on every command. Only image_tag is required.

# The commit tasks.ps1 push built and pushed (it prints this value).
image_tag = "0000000"

# Everything below shows the default.
# region                 = "ap-south-1"
# use_spot               = true      # false = on-demand Fargate (e.g. while recording a demo)
# cpu_architecture       = "ARM64"   # X86_64 needs images built with: .\tasks.ps1 push -Arch amd64
# identity_desired_count = 0         # 1 once Phase 7 gives identity-service its database
