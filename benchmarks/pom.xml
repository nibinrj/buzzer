<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>dev.nibin.buzzer</groupId>
        <artifactId>buzzer-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>benchmarks</artifactId>
    <packaging>jar</packaging>
    <name>benchmarks</name>
    <description>JMH microbenchmarks of scoring and session hot paths. Not a service: no Spring, no Boot plugin.</description>

    <properties>
        <!-- Not managed by the Spring Boot BOM. 1.37 is the latest on Maven Central (2026-10-03). -->
        <jmh.version>1.37</jmh.version>
        <!-- Read by the shade execution inherited from spring-boot-starter-parent: the jar's Main-Class. -->
        <start-class>org.openjdk.jmh.Main</start-class>
    </properties>

    <dependencies>
        <!-- The code under test. Only the services' own classes and resources: every transitive dependency is
             excluded, and the few the benchmarks need are listed below. So no Spring, Hibernate or Logback lands on
             the benchmark classpath, and nothing starts that isn't being measured. -->
        <dependency>
            <groupId>dev.nibin.buzzer</groupId>
            <artifactId>scoring-service</artifactId>
            <version>${project.version}</version>
            <exclusions>
                <exclusion>
                    <groupId>*</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <!-- For lua/submit_answer.lua only: the very file session-service runs. -->
        <dependency>
            <groupId>dev.nibin.buzzer</groupId>
            <artifactId>session-service</artifactId>
            <version>${project.version}</version>
            <exclusions>
                <exclusion>
                    <groupId>*</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>dev.nibin.buzzer</groupId>
            <artifactId>shared-events</artifactId>
        </dependency>
        <!-- What EventReader needs at run time: Jackson 3 and Kafka's ConsumerRecord. -->
        <dependency>
            <groupId>tools.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.kafka</groupId>
            <artifactId>kafka-clients</artifactId>
        </dependency>
        <!-- Redis: the client under Spring Data Redis, used directly, and a throwaway Redis 7 per JMH fork. -->
        <dependency>
            <groupId>io.lettuce</groupId>
            <artifactId>lettuce-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers</artifactId>
        </dependency>
        <dependency>
            <groupId>org.openjdk.jmh</groupId>
            <artifactId>jmh-core</artifactId>
            <version>${jmh.version}</version>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- JMH's annotation processor writes the code that actually runs each @Benchmark (the measurement loop).
                 Named here instead of found on the classpath: JDK 23+ no longer runs classpath processors by default. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.openjdk.jmh</groupId>
                            <artifactId>jmh-generator-annprocess</artifactId>
                            <version>${jmh.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <!-- One runnable jar, target/benchmarks.jar: java -jar target/benchmarks.jar -h. The shade execution and its
                 transformers (META-INF/services files merged, Main-Class from start-class) come from Boot's parent. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <configuration>
                    <finalName>benchmarks</finalName>
                    <createDependencyReducedPom>false</createDependencyReducedPom>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
